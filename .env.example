# Cadena de conexión a MongoDB Atlas
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<nombre_db>?retryWrites=true&w=majority
MONGODB_URI=

# Puerto en el que corre el servidor (opcional, por defecto 3000).
# En el hosting normalmente lo asigna la plataforma: no lo fijes ahí a mano.
PORT=3000

# Entorno: "development" en tu computadora, "production" en el hosting.
# En producción: se sirve el frontend (client/dist), se desactiva /swagger, se exige
# CORS_ORIGIN para permitir otros dominios y se envía el header HSTS (forzar HTTPS).
NODE_ENV=development

# Orígenes (protocolo + dominio, sin "/" al final) que pueden llamar a la API desde el
# navegador. Uno o varios separados por coma.
# - En desarrollo http://localhost:5173 siempre está permitido; no hace falta ponerlo.
# - En producción, si queda vacía no se permite ningún origen externo (la API solo responde
#   a páginas del mismo dominio que la sirve) y el servidor lo avisa en el log al arrancar.
CORS_ORIGIN=https://www.ejemplo.com,https://ejemplo.com

# Llave secreta para firmar/verificar JWT del panel administrativo
# Generala con: bun -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Credenciales de Cloudinary (para la galería de fotos)
# Sácalas de tu dashboard en cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=show-company/gallery

# Correo de notificaciones (Resend). Saca la API key en resend.com → API Keys.
RESEND_API_KEY=

# Remitente. En desarrollo usa onboarding@resend.dev (solo puede enviar al correo dueño
# de la cuenta de Resend). En producción usa una dirección de un dominio verificado en Resend.
EMAIL_FROM=onboarding@resend.dev

# Destinatario de las notificaciones de contacto y cotización.
# En desarrollo: el correo de la cuenta de Resend. En producción: el correo real de la empresa.
EMAIL_TO_NOTIFY=

# ---- Anti-spam ([14.3]) ----
# Para limitar por visitante, el servidor necesita su IP real. Detrás del proxy de un hosting,
# la IP de la conexión es la del proxy (la misma para todos), así que hay que decirle de dónde
# leerla. Se usa la primera opción configurada:
#
# 1. CLIENT_IP_HEADER: header donde el hosting pone la IP del visitante (ej. cf-connecting-ip
#    en Cloudflare, x-real-ip en Railway, fly-client-ip en Fly.io). Solo es seguro si el
#    hosting SOBRESCRIBE ese header en cada petición; si no, el visitante podría inventarlo.
CLIENT_IP_HEADER=
#
# 2. TRUST_PROXY_HOPS: cuántos proxies de confianza hay delante. Con N > 0 la IP se toma de
#    X-Forwarded-For contando N entradas desde el final (lo que agregó el proxy); lo que el
#    visitante escriba a la izquierda se ignora. Detrás del proxy de un hosting, normalmente 1.
# 3. Con TRUST_PROXY_HOPS=0 (por defecto) X-Forwarded-For se ignora y se usa la IP de la conexión.
#    OJO: si hay un proxy delante y no configuras 1 ni 2, TODOS los visitantes comparten el
#    límite. El servidor lo advierte en el log al arrancar en producción.
TRUST_PROXY_HOPS=0

# Envíos por IP a /api/cotizaciones (Contacto y Cotizador) en la ventana, en minutos. Al
# pasarse responde 429 con Retry-After.
RATE_LIMIT_COTIZACIONES_MAX=5
RATE_LIMIT_COTIZACIONES_VENTANA_MIN=10

# Intentos FALLIDOS de inicio de sesión del panel admin por IP (los correctos no cuentan).
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_VENTANA_MIN=15

VITE_WHATSAPP_PHONE=50230738716
