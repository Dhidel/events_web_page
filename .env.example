# Cadena de conexión a MongoDB Atlas
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<nombre_db>?retryWrites=true&w=majority
MONGODB_URI= mongodb+srv://mishellemolinaarana_db_user:show_com_2026@cluster0.lsswe9b.mongodb.net/?appName=Cluster0

# Puerto en el que corre el servidor (opcional, por defecto 3000)
PORT=3000

# Llave secreta para firmar/verificar JWT del panel administrativo
# Generala con: bun -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cloudinary — almacenamiento de las imágenes de la galería.
# Los valores están en tu Dashboard de Cloudinary (Settings → API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta dentro de Cloudinary donde se suben las imágenes (opcional).
CLOUDINARY_FOLDER=show-company/gallery

# Solo para `bun run test-login`: cuenta admin de prueba (nunca escribirla en el código).
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
